# ---------------------------------------------------------
# Bu dosyayı `.env.local` olarak kopyalayın ve DOLDURUN.
# Değerler: Supabase > Project Settings > API bölümünden.
# Bu örnek dosyaya GERÇEK anahtar yazmayın (git'e girer).
# ---------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://PROJENIZ.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# SADECE sunucuda kullanılır — asla NEXT_PUBLIC_ öneki verme!
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Canonical URL / OG etiketleri / sitemap için.
# Yayına alırken GERÇEK alan adınızı yazın (sonunda / olmadan):
#   NEXT_PUBLIC_SITE_URL=https://alanadiniz.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console doğrulama kodu (opsiyonel).
# Search Console > mülk ekle > "HTML etiketi" yönteminde verilen
# content="..." değerini buraya yapıştırın.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
